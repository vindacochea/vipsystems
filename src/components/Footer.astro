---
import { site } from '../data/site.ts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <img
        src="/brand/svg/vipsystems-isotipo-fondo-oscuro.svg"
        alt=""
        width="24"
        height="24"
        aria-hidden="true"
        class="footer-isotipo"
      />
      <span class="footer-text">
        VipSystems — Desarrollo de software, CRM e integraciones. Guayaquil, Ecuador.
      </span>
      <span class="footer-copy">© {year} VipSystems</span>
    </div>

    <nav class="footer-links" aria-label="Redes sociales">
      {site.social.map((link) => (
        <a
          href={link.url}
          rel="noopener"
          target="_blank"
          class="footer-link"
          aria-label={link.label}
        >
          {link.label === 'WhatsApp' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
            </svg>
          )}
          {link.label === 'Facebook' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
            </svg>
          )}
          <span>{link.label}</span>
        </a>
      ))}
      <a
        href={site.googleReviews}
        rel="noopener"
        target="_blank"
        class="footer-link"
      >
        <span>Déjanos una reseña en Google</span>
      </a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
  }

  .footer-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 28px var(--pad-x);
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    align-items: center;
    justify-content: space-between;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .footer-isotipo {
    flex-shrink: 0;
    opacity: 0.7;
  }

  .footer-text {
    font-size: 14px;
    color: var(--text-muted);
  }

  .footer-copy {
    font-size: 14px;
    color: var(--text-muted);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .footer-link:hover {
    color: var(--text);
  }

  @media (max-width: 600px) {
    .footer-inner {
      padding-inline: var(--pad-x-mobile);
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }

    .footer-brand {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
    }
  }
</style>
