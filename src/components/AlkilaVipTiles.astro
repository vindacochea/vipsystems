---
// Funciones de AlkilaVip en 4 tiles. Se muestran mientras no haya captura del sistema.
// TODO(asset): reemplazar por la captura de la pantalla principal cuando esté disponible.
const tiles = [
  {
    label: 'Inventario',
    icono: `<path d="M20 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><path d="M16 3H8l-2 4h12l-2-4z"/><line x1="12" y1="11" x2="12" y2="17"/>`,
  },
  {
    label: 'Proformas y reservas',
    icono: `<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>`,
  },
  {
    label: 'Entregas y retiros',
    icono: `<rect x="1" y="5" width="15" height="13" rx="1"/><path d="M17 8h4l2 4v5h-6V8z"/><circle cx="5" cy="19" r="2"/><circle cx="18.5" cy="19" r="2"/>`,
  },
  {
    label: 'Cobros',
    icono: `<path d="M6 2h12v20l-2-1-2 1-2-1-2 1-2-1-2 1V2z"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/>`,
  },
];
---

<div class="alkilavip-tiles" aria-hidden="true">
  {tiles.map((t) => (
    <div class="tile">
      <svg
        width="28"
        height="28"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="tile-icono"
        set:html={t.icono}
      />
      <span class="tile-label">{t.label}</span>
    </div>
  ))}
</div>

<style>
  .alkilavip-tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .tile {
    background: var(--bg);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-card);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .tile-icono {
    color: var(--green);
    flex-shrink: 0;
  }

  .tile-label {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
  }
</style>
