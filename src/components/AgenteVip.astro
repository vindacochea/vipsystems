---
import Button from './Button.astro';
import { site, waLink, mensajesWa } from '../data/site.ts';
---

<article id="agentevip" class="agentevip">
  <div class="agentevip-text">
    <p class="agentevip-badge">
      <span class="badge">Demo disponible</span>
    </p>
    <h3 class="agentevip-titulo">AgenteVip</h3>
    <p class="agentevip-lema">Tu call center en WhatsApp, conectado a tus sistemas.</p>
    <p class="agentevip-desc">
      AgenteVip atiende a tus clientes por WhatsApp a cualquier hora: responde consultas,
      registra casos y busca información en tu CRM u otros sistemas. Cuando hace falta
      una persona, pasa la conversación a tu equipo.
    </p>
    <div class="agentevip-ctas">
      <Button
        href={waLink(site.whatsapp.agentevip.waId, mensajesWa.pruebaAgenteVip)}
        variant="dark"
        rel="noopener"
        target="_blank"
      >
        Pruébalo ahora · {site.whatsapp.agentevip.number}
      </Button>
      <Button
        href={waLink(site.whatsapp.comercial.waId, mensajesWa.empresaAgenteVip)}
        variant="outline-dark"
        rel="noopener"
        target="_blank"
      >
        Quiero AgenteVip para mi empresa
      </Button>
    </div>
  </div>

  <ul class="agentevip-puntos">
    <li>Atención 24/7</li>
    <li>Integración con CRM y sistemas externos</li>
    <li>Traspaso a un agente humano</li>
    <li>Historial de cada conversación</li>
  </ul>
</article>

<style>
  .agentevip {
    background: var(--green);
    color: var(--bg);
    border-radius: var(--radius-block);
    padding: clamp(28px, 5vw, 56px);
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: center;
  }

  .agentevip-text {
    flex: 1 1 460px;
    min-width: 0;
  }

  .agentevip-badge {
    margin: 0 0 16px;
  }

  .badge {
    background: var(--bg);
    color: var(--text);
    font-size: 13px;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
  }

  .agentevip-titulo {
    margin: 0;
    font-size: clamp(36px, 4.5vw, 52px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--bg);
  }

  .agentevip-lema {
    margin: 12px 0 18px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(18px, 2.2vw, 25px);
    font-weight: 500;
    line-height: 1.3;
    color: var(--bg);
  }

  .agentevip-desc {
    margin: 0;
    font-size: 18px;
    color: var(--bg);
  }

  .agentevip-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .agentevip-puntos {
    flex: 1 1 300px;
    min-width: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .agentevip-puntos li {
    background: rgba(31, 35, 49, 0.1);
    border-radius: 14px;
    padding: 18px 20px;
    font-weight: 600;
    color: var(--bg);
  }

  @media (max-width: 480px) {
    .agentevip-ctas {
      flex-direction: column;
    }

    .agentevip-ctas :global(.btn) {
      width: 100%;
      white-space: normal;
      text-align: center;
    }
  }
</style>
