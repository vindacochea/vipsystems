---
import Button from './Button.astro';
import { site, waLink, mensajesWa, telVisible } from '../data/site.ts';
---

<article id="agentevip" class="agentevip">
  <div class="agentevip-text">
    <div class="agentevip-cabecera">
      <span class="producto-icono">
        <img src="/brand/agentevip/agentevip-isotipo-fondo-oscuro.svg" alt="" width="64" height="64" />
      </span>
      <span class="badge">Demo disponible</span>
    </div>
    <h3 class="agentevip-titulo">AgenteVip <span class="agentevip-titulo-desc">atención al cliente por WhatsApp</span></h3>
    <p class="agentevip-lema">Tu atención por WhatsApp, a cualquier hora y con tu equipo al tanto.</p>
    <p class="agentevip-desc">
      AgenteVip atiende a tus clientes por WhatsApp a cualquier hora: saluda, hace las
      preguntas que necesitas para calificar a cada prospecto y, cuando hace falta una
      persona, pasa la conversación a tu equipo.
    </p>
    <div class="agentevip-ctas">
      <Button
        href={waLink(site.whatsapp.agentevip.waId, mensajesWa.pruebaAgenteVip)}
        variant="dark"
        rel="noopener"
        target="_blank"
      >
        <span class="btn-prueba-wrap">
          <span class="btn-prueba-label">Pruébalo ahora</span>
          <span class="btn-prueba-sep" aria-hidden="true"> · </span>
          <span class="btn-prueba-tel">{telVisible(site.whatsapp.agentevip.number)}</span>
        </span>
      </Button>
      <Button
        href={waLink(site.whatsapp.comercial.waId, mensajesWa.empresaAgenteVip)}
        variant="outline-dark"
        rel="noopener"
        target="_blank"
      >
        Quiero AgenteVip para mi empresa
      </Button>
    </div>
    <a href="/agentevip/" class="agentevip-mas">Conoce cómo funciona</a>
  </div>

  <ul class="agentevip-puntos">
    <li>Atención 24/7</li>
    <li>Preguntas guiadas para calificar prospectos</li>
    <li>Traspaso a un asesor</li>
    <li>Un panel para todo tu equipo</li>
  </ul>
</article>

<style>
  .agentevip {
    background: var(--green);
    color: var(--bg);
    border-radius: var(--radius-block);
    padding: clamp(28px, 5vw, 56px);
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: center;
  }

  .agentevip-text {
    flex: 1 1 min(100%, 460px);
    min-width: 0;
  }

  .agentevip-cabecera {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0 0 20px;
  }

  .producto-icono {
    flex: none;
    width: 64px;
    height: 64px;
    border-radius: var(--radius-card);
    background: var(--bg);
    overflow: hidden;
  }

  .producto-icono img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .badge {
    background: var(--bg);
    color: var(--text);
    font-size: 13px;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: var(--radius-pill);
  }

  .agentevip-titulo {
    margin: 0;
    font-size: clamp(36px, 4.5vw, 52px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--bg);
  }

  .agentevip-titulo-desc {
    display: block;
    font-size: clamp(15px, 1.5vw, 18px);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--bg);
    margin-top: 4px;
  }

  .agentevip-lema {
    margin: 12px 0 18px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(18px, 2.2vw, 25px);
    font-weight: 500;
    line-height: 1.3;
    color: var(--bg);
  }

  .agentevip-desc {
    margin: 0;
    font-size: 18px;
    color: var(--bg);
  }

  .agentevip-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .agentevip-mas {
    display: inline-block;
    margin-top: 20px;
    color: var(--bg);
    font-weight: 600;
    text-underline-offset: 4px;
  }

  .agentevip-mas:hover {
    color: var(--bg);
    text-decoration-thickness: 2px;
  }

  .agentevip-puntos {
    flex: 1 1 min(100%, 300px);
    min-width: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .agentevip-puntos li {
    background: rgba(31, 35, 49, 0.1);
    border-radius: 14px;
    padding: 18px 20px;
    font-weight: 600;
    color: var(--bg);
  }

  .btn-prueba-wrap {
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
  }

  .btn-prueba-tel {
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .agentevip-ctas {
      flex-direction: column;
    }

    .agentevip-ctas :global(.btn) {
      width: 100%;
      white-space: normal;
      text-align: center;
    }

    .btn-prueba-wrap {
      flex-direction: column;
      gap: 2px;
      white-space: normal;
    }

    .btn-prueba-sep {
      display: none;
    }
  }
</style>
