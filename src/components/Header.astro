---
import { site, waLink, mensajesWa } from '../data/site.ts';
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo-link" aria-label="VipSystems — Inicio">
      <img
        src="/brand/svg/vipsystems-horizontal-fondo-oscuro.svg"
        alt="VipSystems"
        width="180"
        height="40"
      />
    </a>

    <nav class="nav-desktop" aria-label="Navegación principal">
      <ul>
        <li><a href="#servicios">Servicios</a></li>
        <li><a href="#productos">Productos</a></li>
        <li><a href="#experiencia">Experiencia</a></li>
        <li><a href="#contacto">Contacto</a></li>
      </ul>
    </nav>

    <a
      href={waLink(site.whatsapp.comercial.waId, mensajesWa.general)}
      class="btn-whatsapp"
      rel="noopener"
      target="_blank"
      aria-label="Contáctanos por WhatsApp"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
      </svg>
      WhatsApp
    </a>

    <!-- Menú móvil sin JS usando details/summary -->
    <details class="nav-mobile">
      <summary aria-label="Abrir menú de navegación">
        <span class="hamburger" aria-hidden="true">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </span>
        <span class="close" aria-hidden="true">
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </span>
      </summary>
      <nav class="mobile-menu" aria-label="Navegación móvil">
        <ul>
          <li><a href="#servicios">Servicios</a></li>
          <li><a href="#productos">Productos</a></li>
          <li><a href="#experiencia">Experiencia</a></li>
          <li><a href="#contacto">Contacto</a></li>
          <li>
            <a
              href={waLink(site.whatsapp.comercial.waId, mensajesWa.general)}
              rel="noopener"
              target="_blank"
              class="mobile-wa"
            >WhatsApp</a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--pad-x);
    height: 68px;
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .logo-link {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .logo-link img {
    height: 36px;
    width: auto;
  }

  /* Desktop nav */
  .nav-desktop {
    flex: 1;
  }

  .nav-desktop ul {
    display: flex;
    list-style: none;
    gap: 32px;
    padding: 0;
  }

  .nav-desktop a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    transition: color 0.15s;
  }

  .nav-desktop a:hover {
    color: var(--text);
  }

  /* WhatsApp button */
  .btn-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--green);
    color: var(--bg);
    text-decoration: none;
    font-size: 15px;
    font-weight: 600;
    padding: 10px 20px;
    min-height: 44px;
    border-radius: var(--radius-pill);
    flex-shrink: 0;
    transition: opacity 0.15s;
  }

  .btn-whatsapp:hover {
    color: var(--bg);
    opacity: 0.88;
  }

  /* Mobile nav */
  .nav-mobile {
    display: none;
  }

  .nav-mobile summary {
    list-style: none;
    cursor: pointer;
    color: var(--text);
    padding: 8px;
    border-radius: 8px;
    display: flex;
    align-items: center;
  }

  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }

  .nav-mobile .close {
    display: none;
  }

  .nav-mobile[open] .hamburger {
    display: none;
  }

  .nav-mobile[open] .close {
    display: flex;
  }

  .mobile-menu {
    position: absolute;
    top: 68px;
    left: 0;
    right: 0;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    padding: 16px var(--pad-x);
  }

  .mobile-menu ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mobile-menu a {
    display: block;
    padding: 12px 0;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
    border-bottom: 1px solid var(--line);
    transition: color 0.15s;
  }

  .mobile-menu li:last-child a {
    border-bottom: none;
  }

  .mobile-menu a:hover,
  .mobile-menu .mobile-wa:hover {
    color: var(--text);
  }

  .mobile-menu .mobile-wa {
    color: var(--green);
  }

  @media (max-width: 768px) {
    .header-inner {
      padding: 0 var(--pad-x-mobile);
      gap: 16px;
    }

    .nav-desktop,
    .btn-whatsapp {
      display: none;
    }

    .nav-mobile {
      display: block;
      margin-left: auto;
    }
  }

  @media (max-width: 480px) {
    .logo-link img {
      height: 28px;
    }
  }
</style>
