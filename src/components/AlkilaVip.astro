---
import Button from './Button.astro';
import AlkilaVipTiles from './AlkilaVipTiles.astro';
import { site, waLink, mensajesWa } from '../data/site.ts';

interface Props {
  // TODO(asset): pasar ruta de imagen real cuando esté disponible (captura de pantalla principal)
  captura?: string;
  capturaAlt?: string;
}

const { captura, capturaAlt = 'Pantalla principal de AlkilaVip' } = Astro.props;
---

<article id="alkilavip" class="alkilavip">
  <div class="alkilavip-text">
    <div class="alkilavip-cabecera">
      <span class="producto-icono">
        <img src="/brand/alkilavip/alkilavip-isotipo-fondo-oscuro.svg" alt="" width="64" height="64" />
      </span>
      <span class="badge">Disponible</span>
    </div>
    <h3 class="alkilavip-titulo">AlkilaVip <span class="alkilavip-titulo-desc">alquiler de mesas, sillas y enseres para eventos</span></h3>
    <p class="alkilavip-lema">Tu negocio de alquiler de enseres, ordenado.</p>
    <p class="alkilavip-desc">
      Para empresas que alquilan sillas, mesas, carpas, menaje y otros enseres para eventos.
      Controla tu inventario, las proformas y reservas, las entregas y retiros, y los cobros
      desde un solo sistema.
    </p>
    <div class="alkilavip-cta-wrap">
      <Button
        href={waLink(site.whatsapp.comercial.waId, mensajesWa.demoAlkilaVip)}
        variant="light"
        rel="noopener"
        target="_blank"
      >
        Solicita una demostración
      </Button>
      <a href="/alkilavip/" class="alkilavip-mas">Conoce todas las funciones</a>
    </div>
  </div>

  <div class="alkilavip-visual">
    {captura ? (
      <img
        src={captura}
        alt={capturaAlt}
        class="alkilavip-captura"
        loading="lazy"
      />
    ) : (
      <AlkilaVipTiles />
    )}
  </div>
</article>

<style>
  .alkilavip {
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-block);
    padding: clamp(28px, 5vw, 56px);
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: center;
  }

  .alkilavip-text {
    flex: 1 1 min(100%, 440px);
    min-width: 0;
  }

  .alkilavip-cabecera {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0 0 20px;
  }

  .producto-icono {
    flex: none;
    width: 64px;
    height: 64px;
    border-radius: var(--radius-card);
    background: var(--bg);
    border: 1px solid var(--line-strong);
    padding: 2px;
  }

  .producto-icono img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .badge {
    border: 1px solid var(--line-soft);
    font-size: 13px;
    font-weight: 600;
    padding: 5px 14px;
    border-radius: var(--radius-pill);
    color: var(--text);
  }

  .alkilavip-titulo {
    margin: 0;
    font-size: clamp(36px, 4.5vw, 52px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .alkilavip-titulo-desc {
    display: block;
    font-size: clamp(15px, 1.5vw, 18px);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--text-muted);
    margin-top: 4px;
  }

  .alkilavip-lema {
    margin: 12px 0 18px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(18px, 2.2vw, 25px);
    font-weight: 500;
    line-height: 1.3;
  }

  .alkilavip-desc {
    margin: 0;
    font-size: 18px;
    color: var(--text-muted);
  }

  .alkilavip-cta-wrap {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }

  .alkilavip-mas {
    font-weight: 600;
    text-underline-offset: 4px;
  }

  @media (max-width: 480px) {
    .alkilavip-cta-wrap :global(.btn) {
      flex: 1 1 100%;
      width: 100%;
      text-align: center;
    }
  }

  /* Visual column */
  .alkilavip-visual {
    flex: 1 1 min(100%, 380px);
    min-width: 0;
  }

  .alkilavip-captura {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-card);
  }

</style>
