---
import Button from './Button.astro';
import { site, waLink, mensajesWa } from '../data/site.ts';

interface Props {
  // TODO(asset): pasar ruta de imagen real cuando esté disponible (captura de pantalla principal)
  captura?: string;
  capturaAlt?: string;
}

const { captura, capturaAlt = 'Pantalla principal de AlkilaVip' } = Astro.props;

const tiles = [
  {
    label: 'Inventario',
    icono: `<path d="M20 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/><path d="M16 3H8l-2 4h12l-2-4z"/><line x1="12" y1="11" x2="12" y2="17"/>`,
  },
  {
    label: 'Reservas por fecha',
    icono: `<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>`,
  },
  {
    label: 'Entregas y retiros',
    icono: `<rect x="1" y="5" width="15" height="13" rx="1"/><path d="M17 8h4l2 4v5h-6V8z"/><circle cx="5" cy="19" r="2"/><circle cx="18.5" cy="19" r="2"/>`,
  },
  {
    label: 'Cobros',
    icono: `<path d="M6 2h12v20l-2-1-2 1-2-1-2 1-2-1-2 1V2z"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="9" y1="12" x2="15" y2="12"/><line x1="9" y1="16" x2="13" y2="16"/>`,
  },
];
---

<article id="alkilavip" class="alkilavip">
  <div class="alkilavip-text">
    <p class="alkilavip-badge">
      <span class="badge">Disponible</span>
    </p>
    <h3 class="alkilavip-titulo">AlkilaVip</h3>
    <p class="alkilavip-lema">Tu negocio de alquiler de enseres, ordenado.</p>
    <p class="alkilavip-desc">
      Para empresas que alquilan sillas, mesas, carpas, menaje y otros enseres para eventos.
      Controla tu inventario, las reservas por fecha, las entregas y retiros, y los cobros
      desde un solo sistema.
    </p>
    <div class="alkilavip-cta-wrap">
      <Button
        href={waLink(site.whatsapp.comercial.waId, mensajesWa.demoAlkilaVip)}
        variant="light"
        rel="noopener"
        target="_blank"
      >
        Solicita una demostración
      </Button>
    </div>
  </div>

  <div class="alkilavip-visual">
    {captura ? (
      <img
        src={captura}
        alt={capturaAlt}
        class="alkilavip-captura"
        loading="lazy"
      />
    ) : (
      <div class="alkilavip-tiles" aria-hidden="true">
        {tiles.map((t) => (
          <div class="tile">
            <svg
              width="28"
              height="28"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="tile-icono"
              set:html={t.icono}
            />
            <span class="tile-label">{t.label}</span>
          </div>
        ))}
      </div>
    )}
  </div>
</article>

<style>
  .alkilavip {
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-block);
    padding: clamp(28px, 5vw, 56px);
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: center;
  }

  .alkilavip-text {
    flex: 1 1 min(100%, 440px);
    min-width: 0;
  }

  .alkilavip-badge {
    margin: 0 0 16px;
  }

  .badge {
    border: 1px solid var(--line-soft);
    font-size: 13px;
    font-weight: 600;
    padding: 5px 14px;
    border-radius: var(--radius-pill);
    color: var(--text);
  }

  .alkilavip-titulo {
    margin: 0;
    font-size: clamp(36px, 4.5vw, 52px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .alkilavip-lema {
    margin: 12px 0 18px;
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(18px, 2.2vw, 25px);
    font-weight: 500;
    line-height: 1.3;
  }

  .alkilavip-desc {
    margin: 0;
    font-size: 18px;
    color: var(--text-muted);
  }

  .alkilavip-cta-wrap {
    margin-top: 32px;
  }

  @media (max-width: 480px) {
    .alkilavip-cta-wrap :global(.btn) {
      width: 100%;
      text-align: center;
    }
  }

  /* Visual column */
  .alkilavip-visual {
    flex: 1 1 min(100%, 380px);
    min-width: 0;
  }

  .alkilavip-captura {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-card);
  }

  /* Tiles: 2×2 grid mostrado mientras no haya captura */
  .alkilavip-tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .tile {
    background: var(--bg);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-card);
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .tile-icono {
    color: var(--green);
    flex-shrink: 0;
  }

  .tile-label {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
  }

</style>
