---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Servicios from '../components/Servicios.astro';
import Productos from '../components/Productos.astro';
import Experiencia from '../components/Experiencia.astro';
import Tecnologias from '../components/Tecnologias.astro';
import Contacto from '../components/Contacto.astro';
---

<Base>
  <main id="contenido">
    <Hero />
    <Servicios />
    <Productos />
    <Experiencia logoCelco="/brand/clientes/celco-logo.webp" />
    <Tecnologias />
    <Contacto />
  </main>
</Base>
