---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.ts';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = 'VipSystems | Desarrollo de software, CRM y facturación electrónica en Guayaquil',
  description = 'Desarrollo a medida, implementación e integración de CRM, facturación y firma electrónica, y AgenteVip: atención al cliente por WhatsApp conectada a tus sistemas. Guayaquil, Ecuador.',
  noindex = false,
} = Astro.props;

const canonical = 'https://vipsystems.site/';
const ogImage = 'https://vipsystems.site/og-vipsystems.png';

const facebookUrl = site.social.find((s) => s.label === 'Facebook')?.url ?? '';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness', 'ProfessionalService'],
  name: site.name,
  url: canonical,
  logo: 'https://vipsystems.site/brand/png/vipsystems-horizontal-fondo-oscuro-2400.png',
  telephone: '+593960510695',
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Guayaquil',
    addressRegion: 'Guayas',
    addressCountry: 'EC',
  },
  areaServed: 'Ecuador',
  sameAs: facebookUrl ? [facebookUrl] : [],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1f2331" />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="VipSystems — Tu CRM, tu facturación y tu atención al cliente, conectados." />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Precarga de la fuente del h1 (Space Grotesk 700 latin). Hash estable hasta próximo upgrade de @fontsource/space-grotesk. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/_astro/space-grotesk-latin-700-normal.RjhwGPKo.woff2"
      crossorigin
    />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Datos estructurados -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <Header />
    <slot />
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 16px;
    background: var(--green);
    color: var(--bg);
    padding: 10px 20px;
    border-radius: 0 0 var(--radius-card) var(--radius-card);
    font-weight: 600;
    text-decoration: none;
    z-index: 9999;
    transition: top 0.1s;
  }

  .skip-link:focus {
    top: 0;
  }
</style>
