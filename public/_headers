/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY

# TODO: agregar Content-Security-Policy cuando se eliminen los estilos inline del JSON-LD y se verifique que no hay style= en el HTML.

# Assets con hash de contenido: caché inmutable un año.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Assets sin hash (marca, OG, favicons): caché de un día para permitir actualizaciones.
/brand/svg/*
  Cache-Control: public, max-age=86400

/brand/png/*
  Cache-Control: public, max-age=86400

/brand/clientes/*
  Cache-Control: public, max-age=86400

/og-vipsystems.png
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/favicon.ico
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/icon-192.png
  Cache-Control: public, max-age=86400

/icon-512.png
  Cache-Control: public, max-age=86400

# El HTML lo gestiona Cloudflare con su caché por defecto (sin max-age largo).
